# ----------------------------------------------------------------
# Global
# ----------------------------------------------------------------
CompileFlags:
  Add:
    - "-Wall"
    - "-Wextra"
    - "-Wpedantic"

Diagnostics:
  UnusedIncludes: Strict

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes

---
# ----------------------------------------------------------------
# C
# ----------------------------------------------------------------
If:
  PathMatch: .*\.(c|h)
CompileFlags:
  Add: -std=c23

---
# ----------------------------------------------------------------
# C++
# ----------------------------------------------------------------
If:
  PathMatch: .*\.(cc|cp|cpp|cxx|c\+\+|C|hh|hpp|hxx|h\+\+)
CompileFlags:
  Add: -std=c++20
