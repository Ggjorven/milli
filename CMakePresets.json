{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "target-x86_64",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/toolchains/x86_64-elf.cmake",
            "cacheVariables": {
                "BOOTLOADER": "bios"
            }
        },
        { "name": "x86_64-debug",   "inherits": "target-x86_64", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "x86_64-release", "inherits": "target-x86_64", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
    ],
    "buildPresets": [
        { "name": "x86_64-debug",   "configurePreset": "x86_64-debug" },
        { "name": "x86_64-release", "configurePreset": "x86_64-release" }
    ]
}
