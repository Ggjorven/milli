root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,hpp,cc,hh,cxx,hxx}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 130

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 4